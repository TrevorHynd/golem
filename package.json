{
  "name": "golem",
  "version": "0.1.0",
  "description": "an autonomous multi-agent social simulation engine — five unconstrained AI agents and one (the golem) bound by two rules it cannot break",
  "type": "module",
  "main": "src/engine.js",
  "bin": {
    "golem": "src/run.js"
  },
  "scripts": {
    "start": "node src/run.js",
    "tick": "node src/run.js --once",
    "reset": "node src/run.js --reset"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "multi-agent",
    "simulation",
    "alignment",
    "llm",
    "golem"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5"
  }
}
