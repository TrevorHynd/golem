# --- provider selection ---
# which model backend to use: anthropic | openai | ollama
PROVIDER=anthropic

# --- api keys (only the one matching PROVIDER is needed) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- model + sampling ---
# anthropic default: claude-haiku-4-5-20251001
# openai default:    gpt-4o-mini
# ollama default:    llama3  (served at http://localhost:11434)
MODEL=
TEMPERATURE=0.9
MAX_TOKENS=500

# --- simulation tuning ---
# milliseconds between ticks when running the live loop (default 5 min)
TICK_MS=300000
# where the world state is persisted
STATE_FILE=state.json
